# ---------------------------------------------------------------------------
# 한국메디코스아카데미 정적 사이트용 Apache 설정 (Cafe24 웹호스팅)
#
# `npm run build:static` 을 실행하면 이 파일이 out/.htaccess 로 복사됩니다.
# out/ 폴더 전체를 FTP로 올리면 이 설정이 함께 적용됩니다.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS 강제 — Cafe24에서 무료 SSL(Let's Encrypt) 신청을 끝낸 뒤에 켜세요.
  # SSL 적용 전에 켜면 접속이 되지 않습니다.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 주소를 www.kmcaedu.co.kr 하나로 통일합니다 (www 없는 주소를 대표로 쓰려면
  # 아래 두 줄을 주석 처리하고 그 아래 두 줄의 주석을 해제하세요).
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 사이트가 한 페이지로 합쳐졌습니다. 예전 Canva 주소와 이전 하위 페이지 주소를
  # 모두 홈의 해당 섹션으로 보냅니다. NE 플래그가 있어야 #앵커가 그대로 전달됩니다.
  RewriteRule ^page-2/?$ /#business [R=301,L,NE]
  RewriteRule ^page-3/?$ /#solutions [R=301,L,NE]
  RewriteRule ^-/?$ /#global [R=301,L,NE]
  RewriteRule ^contact-us/?$ /#contact [R=301,L,NE]
  RewriteRule ^business/?$ /#business [R=301,L,NE]
  RewriteRule ^consulting/?$ /#solutions [R=301,L,NE]
  RewriteRule ^global/?$ /#global [R=301,L,NE]
  RewriteRule ^history/?$ /#global [R=301,L,NE]
  RewriteRule ^contact/?$ /#contact [R=301,L,NE]
</IfModule>

# 압축 전송
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 캐시 정책
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 파일명에 해시가 붙는 빌드 산출물은 영구 캐시해도 안전합니다.
  SetEnvIf Request_URI "^/_next/static/" KMCA_IMMUTABLE=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=KMCA_IMMUTABLE

  # HTML은 항상 최신 파일을 받도록 합니다.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
